# Agnes AI API 配置（本地开发CLI使用）
AGNES_API_KEY=sk-your-key-here
AGNES_API_BASE=https://apihub.agnes-ai.com/v1

# 图片生成模型
AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# 视频生成模型
AGNES_VIDEO_MODEL=agnes-video-v2.0

# AI 聚合搜索与分析（必填，否则 AI 推荐/摘要/演员分析功能不可用）
UNLIMITED_AI_KEY=your-unlimited-ai-key-here

# ─── 认证核心变量 ───
# 站长账号 / 密码（登录 + 签名密钥回退）
USERNAME=admin
PASSWORD=your-secure-password

# 独立签名密钥（推荐设置随机长字符串；未配置时回退使用 PASSWORD 做 cookie 签名）
AUTH_SECRET=openssl-rand-hex-64

# 存储：kvrocks / redis / upstash / localstorage
NEXT_PUBLIC_STORAGE_TYPE=kvrocks
STORAGE_TYPE=kvrocks
KVROCKS_URL=redis://127.0.0.1:6379

# 信任网络自动登录角色（admin 或 user），默认 admin
TRUSTED_NETWORK_ROLE=admin

# ─── 字幕源（可选）───
# OpenSubtitles 官方 API（https://www.opensubtitles.com 免费注册获取）
# 配置后播放页自动按片名搜索并加载中文字幕
OPENSUBTITLES_API_KEY=your-opensubtitles-api-key
# 以下两个用于获取字幕文件下载链接（可选；不配置则仅展示搜索结果）
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Cloudflare 账户 ID（wrangler.toml 使用，通过环境变量注入）
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Telegram Webhook 额外允许的 Host（逗号分隔）
TELEGRAM_WEBHOOK_EXTRA_HOSTS=
